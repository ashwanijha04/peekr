{
  "name": "@peekr/sdk",
  "version": "0.1.0",
  "description": "Zero-config observability for AI agents — TypeScript SDK. Auto-instruments OpenAI and Anthropic, writes spans to JSONL/SQLite for analysis by the Python peekr CLI and dashboard.",
  "license": "MIT",
  "author": "Ashwani Jha <ashwanijha04@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashwanijha04/peekr",
    "directory": "peekr-ts"
  },
  "homepage": "https://ashwanijha04.github.io/peekr",
  "keywords": [
    "observability",
    "tracing",
    "ai",
    "agents",
    "llm",
    "openai",
    "anthropic",
    "hallucination-detection",
    "rag"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test build-tests/tests/**/*.test.js",
    "clean": "rm -rf dist build-tests",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.3.0"
  }
}
